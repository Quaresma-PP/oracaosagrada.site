# Supabase (mesma instância do projeto principal)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Login da conta de cliente já cadastrada na Loja Santuário Nacional,
# com um cartão salvo. Recomendado: cartão dedicado, com limite baixo,
# só pra esse robô.
STORE_LOGIN_EMAIL=seu-login@exemplo.com
STORE_LOGIN_SENHA=sua-senha

# Só preencha se o checkout pedir CVV mesmo usando o cartão salvo.
# Fica só nas variáveis de ambiente do Railway — nunca commitar.
STORE_CARD_CVV=

# "validacao": prepara tudo e para antes de pagar, esperando aprovação no
#   painel /admin.
# "automatico": paga sozinho assim que o pedido chega, sem parar.
COMPRA_MODO=validacao

# Trava de segurança: se o total do carrinho passar desse valor (em reais),
# o robô SEMPRE para pra aprovação manual, mesmo em modo automático.
VALOR_MAXIMO_COMPRA_AUTOMATICA=300

# De quanto em quanto tempo o worker verifica se tem pedido novo (ms).
POLL_INTERVAL_MS=60000
